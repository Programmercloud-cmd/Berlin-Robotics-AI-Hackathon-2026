# PostgreSQL DSN, or leave empty for the bundled local PostgreSQL in demo mode.
DATABASE_URL=

# Optional OpenAI-compatible endpoint. Set the model name your provider exposes.
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=
MODEL_API_KEY=

# Select devin or a locally authenticated Codex CLI with codex.
EYE_MODEL=
DEVIN_API_KEY=
DEVIN_ORG_ID=
# Optional Devin agent mode. Leave empty to use the organization's default.
DEVIN_MODE=
